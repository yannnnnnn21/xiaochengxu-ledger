:host {
  display: block;
}

.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 6rpx 40rpx env(safe-area-inset-bottom);
  display: flex;
  align-items: stretch;
  background: rgba(255, 253, 250, 0.98);
  border-top: 1rpx solid rgba(103, 75, 60, 0.06);
  box-shadow: 0 -8rpx 24rpx rgba(128, 88, 62, 0.06);
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6c4f41;
}

.active-dash {
  position: absolute;
  top: -6rpx;
  width: 38rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: transparent;
}

.is-active .active-dash {
  background: #eb9d6d;
}

.tab-label {
  margin-top: 8rpx;
  color: #8c6b5b;
  font-size: 22rpx;
  right: 7rpx;
}

.is-active .tab-label {
  color: #5e4336;
  font-weight: 600;
}

.bill-tab .tab-label {
  position: relative;
  left: 8rpx;
  right: auto;
}

.line-icon {
  position: relative;
  width: 54rpx;
  height: 48rpx;
}

.icon-home .home-roof {
  position: absolute;
  top: 6rpx;
  left: 12rpx;
  width: 30rpx;
  height: 30rpx;
  border-top: 4rpx solid #8a6250;
  border-left: 4rpx solid #8a6250;
  border-radius: 4rpx;
  transform: rotate(45deg);
}

.icon-home .home-body {
  position: absolute;
  left: 10rpx;
  bottom: 3rpx;
  width: 34rpx;
  height: 27rpx;
  border: 4rpx solid #8a6250;
  border-top: none;
  border-radius: 3rpx 3rpx 6rpx 6rpx;
}

.is-active .icon-home .home-roof {
  border-color: #ec9d6c;
}

.is-active .icon-home .home-body {
  border-color: #ec9d6c;
  border-top: none;
}

.icon-add {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid #805a49;
  border-radius: 50%;
}

.plus-horizontal,
.plus-vertical {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 3rpx;
  background: #805a49;
  transform: translate(-50%, -50%);
}

.plus-horizontal {
  width: 25rpx;
  height: 4rpx;
}

.plus-vertical {
  width: 4rpx;
  height: 25rpx;
}

.is-active .icon-add {
  border-color: #ec9d6c;
}

.is-active .plus-horizontal,
.is-active .plus-vertical {
  background: #ec9d6c;
}

.icon-receipt {
  left: 8rpx;
  width: 38rpx;
  height: 46rpx;
  border: 4rpx solid #805a49;
  border-radius: 4rpx;
}

.receipt-line {
  position: absolute;
  left: 9rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #805a49;
}

.line-one {
  top: 12rpx;
  width: 15rpx;
}

.line-two {
  top: 22rpx;
  width: 15rpx;
}

.line-three {
  top: 32rpx;
  width: 15rpx;
}

.is-active .icon-receipt {
  border-color: #ec9d6c;
}

.is-active .receipt-line {
  background: #ec9d6c;
}

.icon-user .user-head {
  position: absolute;
  top: 2rpx;
  left: 18rpx;
  width: 19rpx;
  height: 19rpx;
  border: 4rpx solid #805a49;
  border-radius: 50%;
}

.icon-user .user-shoulder {
  position: absolute;
  bottom: 2rpx;
  left: 7rpx;
  width: 37rpx;
  height: 21rpx;
  border: 4rpx solid #805a49;
  border-bottom: none;
  border-radius: 24rpx 24rpx 0 0;
}

.is-active .icon-user .user-head {
  border-color: #ec9d6c;
}

.is-active .icon-user .user-shoulder {
  border-color: #ec9d6c;
  border-bottom: none;
}
