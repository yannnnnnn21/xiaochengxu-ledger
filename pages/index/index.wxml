<view class="page-shell">
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view style="padding-top: {{statusBarHeight}}px;">
      <view class="home-header">
        <text class="month-eyebrow">{{englishMonth}}</text>
        <view class="brand-row">
          <view>
            <text class="brand-title">小熊账本</text>
            <text class="brand-note">认真生活，也认真存下每一份小确幸</text>
          </view>
          <view class="budget-pill">
            <view class="budget-dot"></view>
            <text>{{budgetStatus}}</text>
          </view>
        </view>
      </view>

      <view class="content home-content">
        <view class="balance-card soft-card">
          <view class="balance-top">
            <view>
              <text class="balance-label">本月结余</text>
              <view class="balance-amount">
                <text class="currency">¥</text>
                <text>{{balanceText}}</text>
              </view>
            </view>
            <view class="mini-bear">
              <view class="bear-ear left"></view>
              <view class="bear-ear right"></view>
              <view class="bear-head">
                <view class="bear-eye left"></view>
                <view class="bear-eye right"></view>
                <view class="bear-muzzle">
                  <view class="bear-nose"></view>
                </view>
              </view>
              <view class="bear-shirt"></view>
            </view>
          </view>

          <view class="balance-divider"></view>
          <view class="balance-stats">
            <view class="stat-item">
              <view class="stat-icon income-icon">
                <view class="mini-arrow up-arrow"></view>
              </view>
              <view class="stat-copy">
                <text class="stat-label">本月收入</text>
                <text class="stat-value">¥ {{incomeText}}</text>
              </view>
            </view>
            <view class="stat-line"></view>
            <view class="stat-item">
              <view class="stat-icon expense-icon">
                <view class="mini-arrow down-arrow"></view>
              </view>
              <view class="stat-copy">
                <text class="stat-label">本月支出</text>
                <text class="stat-value">¥ {{expenseText}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="chart-section">
          <view class="section-heading chart-heading">
            <view>
              <text class="section-subtitle">{{monthLabel}}消费分布</text>
              <text class="section-title">钱都花去哪啦？</text>
            </view>
            <button
              class="chart-details-button"
              style="width: 132rpx; min-width: 0; max-width: 132rpx; padding: 8rpx 0;"
              bindtap="openBills"
            >查看详情</button>
          </view>

          <view class="chart-body">
            <view class="doodle doodle-heart">♡</view>
            <view class="doodle doodle-coin">¥</view>
            <view class="donut-wrap">
              <canvas
                id="spendingChart"
                type="2d"
                class="donut-renderer"
              ></canvas>
              <image
                wx:if="{{chartImage}}"
                class="donut-canvas"
                src="{{chartImage}}"
                mode="aspectFit"
              ></image>
              <view class="donut-hole">
                <view class="wallet-icon">
                  <view class="wallet-line"></view>
                </view>
                <text class="donut-label">总支出</text>
                <text class="donut-value">¥{{expenseText}}</text>
              </view>
            </view>
          </view>

          <view class="chart-legend">
            <view
              class="legend-item"
              wx:for="{{chartEntries}}"
              wx:key="name"
            >
              <view class="legend-title">
                <view class="legend-dot" style="background: {{item.color}};"></view>
                <text class="legend-name">{{item.name}}</text>
                <text class="legend-percent">{{item.percent}}%</text>
              </view>
              <text class="legend-value">¥ {{item.valueText}}</text>
            </view>
          </view>
        </view>

        <view class="recent-section">
          <view class="section-heading recent-heading">
            <text class="section-title">最近账单</text>
            <button class="more-button" bindtap="openBills">全部账单 →</button>
          </view>

          <view
            class="recent-card soft-card"
            wx:for="{{recentBills}}"
            wx:key="id"
          >
            <view class="category-badge badge-{{item.tone}}">
              <text>{{item.icon}}</text>
            </view>
            <view class="recent-info">
              <view class="recent-name-row">
                <text class="recent-name">{{item.category}}</text>
                <text class="category-tag">{{item.note}}</text>
              </view>
              <text class="recent-time">{{item.dateText}}</text>
            </view>
            <text class="recent-amount {{item.type === 'income' ? 'income-text' : ''}}">
              {{item.amountPrefix}}¥{{item.amountText}}
            </text>
          </view>

          <view wx:if="{{!recentBills.length}}" class="soft-card empty-state">
            <view class="empty-bear"><view class="empty-bear-face"></view></view>
            <text>还没有账单，先记下今天的第一笔吧</text>
            <button class="inline-add" bindtap="openAdd">去记一笔</button>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <tab-bar active="home"></tab-bar>
</view>
