.add-nav {
  padding-right: 190rpx;
}

.pastry-doodle {
  font-size: 48rpx;
  transform: rotate(18deg);
}

.add-content {
  padding-top: 12rpx;
}

.type-switch {
  width: 530rpx;
  height: 94rpx;
  margin: 12rpx auto 50rpx;
  padding: 7rpx;
  display: flex;
  background: rgba(255, 253, 250, 0.93);
  border: 1rpx solid rgba(109, 76, 57, 0.06);
  border-radius: 30rpx;
  box-shadow: 0 8rpx 22rpx rgba(143, 101, 73, 0.08);
}

.type-option {
  flex: 1;
  color: #9b8175;
  font-size: 28rpx;
  line-height: 1;
  border-radius: 24rpx;
}

.type-option.active {
  color: #5d4236;
  font-weight: 700;
  background: #f3d36c;
}

.form-section {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  margin: 0 0 17rpx 8rpx;
  color: #92786b;
  font-size: 25rpx;
}

.amount-box {
  height: 142rpx;
  padding: 0 48rpx;
  display: flex;
  align-items: center;
  line-height: 1;
  background: #fffdfa;
  border: 2rpx solid rgba(104, 76, 60, 0.05);
  border-radius: 38rpx;
  box-shadow: 0 8rpx 0 rgba(221, 202, 187, 0.42);
}

.amount-symbol {
  margin-right: 22rpx;
  color: #5f4438;
  font-family: Georgia, serif;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1;
}

.amount-input {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  color: #5f4438;
  font-family: Georgia, serif;
  font-size: 47rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.input-placeholder {
  color: #bda99f;
  font-size: 30rpx;
  font-weight: 400;
}

.category-row {
  display: flex;
  gap: 10rpx;
}

.category-option {
  flex: 1;
  min-width: 0;
  height: 128rpx;
  padding: 10rpx 3rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  color: #705446;
  font-size: 20rpx;
  background: #fffdfa;
  border: 2rpx solid rgba(103, 74, 56, 0.04);
  border-radius: 22rpx;
  transition: transform 120ms ease;
}

.category-option > text {
  line-height: 1;
}

.category-option.selected {
  background: #f5d879;
  border-color: #9d7750;
  box-shadow: inset 0 -5rpx 0 rgba(128, 89, 55, 0.12);
  transform: translateY(-3rpx);
}

.category-icon {
  width: 63rpx;
  height: 63rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 19rpx;
  font-size: 34rpx;
}

.selected .category-icon {
  background: rgba(255, 251, 241, 0.45);
}

.tone-peach {
  background: #fae3df;
}

.tone-blue {
  background: #e2edf4;
}

.tone-sage {
  background: #dfeade;
}

.tone-lilac {
  background: #eadff1;
}

.tone-yellow {
  background: #f9eab9;
}

.date-box {
  height: 105rpx;
  padding: 0 42rpx;
  display: flex;
  align-items: center;
  background: #fffdfa;
  border-radius: 31rpx;
}

.calendar-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  margin-right: 24rpx;
  border: 3rpx solid #62493d;
  border-radius: 5rpx;
}

.calendar-icon::before {
  content: "";
  position: absolute;
  top: 8rpx;
  right: 0;
  left: 0;
  height: 3rpx;
  background: #62493d;
}

.calendar-rings::before,
.calendar-rings::after {
  content: "";
  position: absolute;
  top: -6rpx;
  width: 4rpx;
  height: 11rpx;
  border-radius: 3rpx;
  background: #62493d;
}

.calendar-rings::before {
  left: 8rpx;
}

.calendar-rings::after {
  right: 8rpx;
}

.calendar-day {
  padding-top: 11rpx;
  color: #62493d;
  font-size: 13rpx;
  text-align: center;
}

.date-value {
  flex: 1;
  color: #6b5043;
  font-family: Georgia, serif;
  font-size: 28rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.calendar-small {
  position: relative;
  width: 28rpx;
  height: 27rpx;
  border: 2rpx solid #6e5548;
  border-radius: 3rpx;
}

.calendar-small::before {
  content: "";
  position: absolute;
  top: 7rpx;
  right: 0;
  left: 0;
  height: 2rpx;
  background: #6e5548;
}

.calendar-small::after {
  content: "";
  position: absolute;
  top: 11rpx;
  left: 5rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 1rpx;
  background: #6e5548;
  box-shadow: 8rpx 0 #6e5548, 0 7rpx #6e5548, 8rpx 7rpx #6e5548;
}

.note-box {
  width: 100%;
  height: 154rpx;
  padding: 31rpx 36rpx;
  color: #674c3f;
  font-size: 26rpx;
  line-height: 1.6;
  background: #fffdfa;
  border-radius: 31rpx;
}

.save-wrap {
  position: relative;
  margin: 58rpx 0 40rpx;
}

.save-button {
  height: 102rpx;
  line-height: 1;
  color: #5d4236;
  font-size: 31rpx;
  font-weight: 700;
  background: #f4d56f;
  border: 2rpx solid rgba(91, 64, 49, 0.07);
  border-radius: 34rpx;
  box-shadow: 0 9rpx 0 #766151;
}

.coin-doodle {
  position: absolute;
  left: -11rpx;
  bottom: -26rpx;
  width: 41rpx;
  height: 41rpx;
  padding-top: 7rpx;
  color: #8f7358;
  font-family: Georgia, serif;
  font-size: 19rpx;
  text-align: center;
  border: 2rpx solid #8f7358;
  border-radius: 50%;
  background: #efd6a3;
  transform: rotate(-14deg);
}
