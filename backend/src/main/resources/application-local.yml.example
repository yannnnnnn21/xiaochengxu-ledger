spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://127.0.0.1:3306/warm_ledger?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
    username: root
    password: "YOUR_MYSQL_PASSWORD"
    hikari:
      maximum-pool-size: 10
      minimum-idle: 2
      connection-timeout: 10000

